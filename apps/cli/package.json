    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@evalshield/core": "workspace:*",
    "@evalshield/journal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
