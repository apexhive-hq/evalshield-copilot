{
  "name": "@evalshield/journal",
  "version": "1.0.0",
  "description": "Local node:sqlite WAL trade journal, multi-broker CSV adapters, FIFO matcher, HMAC read-only webhook sink, and localhost dashboard API server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@evalshield/core": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
